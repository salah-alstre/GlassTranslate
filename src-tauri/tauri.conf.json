{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassTranslate Lite",
  "version": "1.1.2",
  "identifier": "com.glasstranslate.lite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: gtshot: http://gtshot.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "GlassTranslate",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Instant offline English to Arabic screen translation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/model/*": "model/",
      "resources/model-he-ar/*": "model-he-ar/",
      "resources/tesseract/*": "tesseract/",
      "resources/tesseract/tessdata/*": "tesseract/tessdata/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Arabic"],
        "compression": "lzma"
      }
    }
  }
}
